<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /vrassociates/

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Remove trailing slashes (unless it's a directory)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ $1 [L,R=301]

  # Remove .html extension from direct requests
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /+(.*)\.html [NC]
  RewriteRule ^(.*)\.html$ $1 [R=301,L]

  # Route extensionless URLs to their corresponding .html files
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Custom 404 Page (Next.js automatically generates a 404.html)
  ErrorDocument 404 /vrassociates/404.html
</IfModule>
